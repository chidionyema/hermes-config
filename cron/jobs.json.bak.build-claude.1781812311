    {
      "id": "9ba1919c7386",
      "name": "Run health check on all projects: check for outdat",
      "prompt": "Run health check on all projects: check for outdated dependencies, security vulnerabilities, test failures, and complexity hotspots. Report any issues found.",
      "skills": [],
      "skill": null,
      "model": null,
      "provider": null,
      "base_url": null,
      "script": "cd ~/Documents/code && for repo in lux signalengine prospector; do echo \"=== $repo ===\" && cd \"$repo\" 2>/dev/null && (uv run pytest -q --tb=short -m \"not slow\" 2>&1 | tail -3) && cd .. || echo \"  skipped\"; done",
