    {
      "id": "ca7dde96adcf",
      "name": "Run lux verify on all projects with specs. Report",
      "prompt": "Run lux verify on all projects with specs. Report total specs verified, failures, cross-project patterns. Save to ~/.hermes/reports/weekly-verification.md",
      "skills": [],
      "skill": null,
      "model": null,
      "provider": null,
      "base_url": null,
      "script": "#!/bin/bash\n# Weekly lux verify across all projects with specs\ncd ~/Documents/code/lux && echo \"=== LUX ===\" && npm run lux -- spec verify 2>&1 | tail -5\ncd ~/Documents/code/signalengine && echo \"=== Signal Engine ===\" && uv run lux-spec spec verify 2>&1 | tail -5\ncd ~/Documents/code/prospector && echo \"=== Prospector ===\" && uv run lux-spec spec verify 2>&1 | tail -5",
